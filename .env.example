# Groq API Key (Required for /google-search)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (Required for /openai-search)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (Required for /gemini-search)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Custom Webhook URL for results
# WEBHOOK_URL=https://your-domain.com/webhook

# Optional: Database URL (default is sqlite:///./tasks.db)
# DATABASE_URL=sqlite:///./tasks.db

# Optional: Maximum PDF upload size in MB for the /extract-pdf/ endpoint (default: 20)
# PDF_MAX_FILE_SIZE_MB=20
